---
apiVersion: v1
kind: Service
metadata:
  name: opensearch-nodeport
  namespace: {{ opensearch_namespace }}
spec:
  type: NodePort
  selector:
    app: opensearch-cluster-nodes

  ports:
    - name: http
      protocol: TCP
      # Port exposed within the cluster
      port: 9200
      # Port on the pod to forward traffic to
      targetPort: 9200
      # NodePort is the port on each node to access the service
      nodePort: {{ opensearch_nodeport_http }}
