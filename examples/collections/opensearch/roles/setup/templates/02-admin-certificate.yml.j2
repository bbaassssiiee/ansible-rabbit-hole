---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: opensearch-admin-cert
  namespace: "{{ opensearch_namespace }}"
spec:
  commonName: admin
  subject:
    organizations:
      - "{{ cluster_name }}"
  dnsNames:
    - localhost
    - opensearch.{{ domain_name }}
    - opensearch-api.{{ domain_name }}
  isCA: false
  duration: 2160h # 90 days
  renewBefore: 360h # 15 days
  issuerRef:
    name: "{{ cluster_issuer }}"
    kind: ClusterIssuer
  privateKey:
    algorithm: RSA
    encoding: PKCS8
    size: 4096
  secretName: opensearch-admin-cert
  usages:
    - digital signature
    - key encipherment
    - client auth
